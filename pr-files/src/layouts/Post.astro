---
import Base from './Base.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, date, updated, tags, image } = post.data;

function formatDate(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Base title={`${title} — Jeff Salleh`} description={description} image={image}>
  <div class="container">
    <article>
      <header class="post-header">
        <div class="post-card__meta">
          <time class="post-date" datetime={date.toISOString()}>{formatDate(date)}</time>
          {updated && (
            <span class="post-date">· updated {formatDate(updated)}</span>
          )}
          {tags.map(tag => (
            <a href={`/tags/${tag}`} class="tag">{tag}</a>
          ))}
        </div>
        <h1>{title}</h1>
        {description && <p class="post-header__desc">{description}</p>}
        {image && (
          <figure class="post-figure">
            <img src={image} alt={title} />
          </figure>
        )}
      </header>

      <div class="post-body">
        <slot />
      </div>

      <a href="/" class="back-link">← All posts</a>
    </article>
  </div>
</Base>
