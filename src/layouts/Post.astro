---
import Base from './Base.astro';
import type { CollectionEntry } from 'astro:content';
import { engagements, longDate, anchorId } from '../data/engagements';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, date, updated, tags, image } = post.data;

// The engagement this post came out of, if any.
const engagement = engagements.find((e) => e.public && e.post === post.slug);

function formatDate(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Base title={`${title} — Jeff Salleh`} description={description} image={image}>
  <div class="container">
    <article>
      <header class="post-header">
        <div class="post-card__meta">
          <time class="post-date" datetime={date.toISOString()}>{formatDate(date)}</time>
          {updated && (
            <span class="post-date">· updated {formatDate(updated)}</span>
          )}
          {tags.map(tag => (
            <a href={`/tags/${tag}`} class="tag">{tag}</a>
          ))}
        </div>
        <h1>{title}</h1>
        {description && <p class="post-header__desc">{description}</p>}
        {image && (
          <figure class="post-figure">
            <img src={image} alt={title} />
          </figure>
        )}
      </header>

      <div class="post-body">
        <slot />
      </div>

      {engagement && (
        <aside class="eng-note">
          <span class="eng-note__kicker">// from the session</span>
          This post came out of{' '}
          <a href={`/speaking#${anchorId(engagement)}`}>{engagement.title}</a>,{' '}
          {engagement.organiser}, {longDate(engagement.date)}.{' '}
          <a class="eng-note__all" href="/speaking">All speaking →</a>
        </aside>
      )}

      <a href="/" class="back-link">← All posts</a>
    </article>
  </div>
</Base>
